<%= render "shared/sub_header", title: "通知一覧",back_path: home_path %>

<div class="min-h-screen bg-base-200 pt-8">
  <div class="mt-6 mb-4 max-w-lg mx-auto divide-y divide-base-300 px-4">
    <div class="card bg-base-100 shadow-md">
      <div class="card-body text-center">

        <% @notifications.each do |notification| %>
          <div style="border-bottom: 1px solid #ccc; padding: 10px;">

            <p style="font-weight: <%= notification.is_read ? 'normal' : 'bold' %>;">
              <%= notification.message %>
            </p>
        
            <small><%= notification.created_at.strftime("%Y-%m-%d %H:%M") %></small>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>