<%= render "shared/sub_header", title: "設定",back_path: home_path %>

<div class="mt-6 mb-4 max-w-lg mx-auto divide-y divide-base-300 px-4">

  <%= link_to default_bread_path, class: "flex items-center justify-between py-4" do %>
    <span>いつも食べるパンの設定</span>
    <span class="text-base-content/40">›</span>
  <% end %>

  <%= link_to notification_setting_path, class: "flex items-center justify-between py-4" do %>
    <span>LINE通知設定</span>
    <span class="text-base-content/40">›</span>
  <% end %>

    <%= link_to groups_path, class: "flex items-center justify-between py-4" do %>
      <span>グループ共有👥</span>
      <span class="text-base-content/40">›</span>
    <% end %>

  <%= link_to terms_path, class: "flex items-center justify-between py-4" do %>
    <span>利用規約</span>
    <span class="text-base-content/40">›</span>
  <% end %>

  <%= link_to privacy_path, class: "flex items-center justify-between py-4" do %>
    <span>プライバシーポリシー</span>
    <span class="text-base-content/40">›</span>
  <% end %>

  <%= link_to contact_path, class: "flex items-center justify-between py-4" do %>
    <span>お問合せ</span>
    <span class="text-base-content/40">›</span>
  <% end %>

</div>

<% if user_signed_in? %>
  <div class="text-center text-sm opacity-60 mt-10 max-w-lg mx-auto px-4">
    <%= button_to "ログアウト",
      destroy_user_session_path,
      method: :delete,
      data: { turbo: false },
      class: "btn btn-ghost btn-xs" %>
  </div>
<% end %>