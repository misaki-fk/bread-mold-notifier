<%= form_with model: @bread, local: true do |f| %>

  <%= render "shared/bread_fields", f: f %>

  <div class="form-control mb-4">
    <%= f.label :expiration_date, "消費期限", class: "label" %>
  
    <!-- 手動入力 -->
    <%= f.date_field :expiration_date, id: "expirationField", class: "input input-bordered mb-2" %>
  
    <!-- 区切り -->
    <div class="text-center text-sm text-gray-400 my-2">または</div>
  
    <!-- OCR -->
    <label class="btn btn-outline w-full cursor-pointer">
      📷 画像から自動入力
      <input type="file" id="imageInput" accept="image/*" class="hidden">
    </label>
  </div>

   <!-- ボタン -->
  <div class="form-control mt-8">
    <div class="flex justify-center">
      <%= f.submit @bread.persisted? ? "更新する" : "登録する",
      class: "btn btn-primary w-48" %>
    </div>
  </div>
<% end %>