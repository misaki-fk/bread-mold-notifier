<%= form_with model: @bread, local: true, data: { controller: "ocr" } do |f| %>

  <%= render "shared/bread_fields", f: f %>

  <div class="form-control mb-4">
    <%= f.label :expiration_date, "消費期限", class: "label" %>



    <!-- 手動入力 -->
    <%= f.date_field :expiration_date,
    data: { ocr_target: "field" },
    class: "input input-bordered mb-2" %>

    <p data-ocr-target="status" class="text-sm text-gray-500 mt-1"></p>

    <% if user_signed_in? && !current_user.guest? %>
    <!-- 区切り -->
    <div class="text-center text-sm text-gray-400 my-2">または</div>

    <!-- OCR -->  
    <label class="btn btn-outline w-full cursor-pointer">
      📷 画像から自動入力
      <input type="file"
             data-ocr-target="input"
             data-action="change->ocr#upload"
             accept="image/*"
             class="hidden">
    </label>
    <% end %>
  </div>


   <!-- ボタン -->
  <div class="form-control mt-8">
    <div class="flex justify-center">
      <%= f.submit @bread.persisted? ? "更新する" : "登録する",
      class: "btn btn-primary w-48" %>
    </div>
  </div>
<% end %>