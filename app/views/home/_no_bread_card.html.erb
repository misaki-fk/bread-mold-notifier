<% content_for :header do %>
  <%= render "layouts/header" %>
<% end %>

<div class="card w-full max-w-sm h-[580px] bg-base-100 shadow-md">
  <div class="flex flex-col items-center justify-center text-center gap-4 p-8 h-full">
    <p class="text-base font-semibold">
      パンがありません
    </p>

    <%= link_to "#", class: "btn btn-primary w-48 mt-4" do %>
      パンを登録
    <% end %>

    <!-- logouttest用あとで消します -->
    <% if user_signed_in? %>
    <div class="text-right text-sm opacity-60 mt-4">
    <%= button_to "ログアウト",
        destroy_user_session_path,
        method: :delete,
        data: { turbo: false },
        class: "btn btn-ghost btn-xs" %>
    </div>
    <% end %>

  </div>
</div>
