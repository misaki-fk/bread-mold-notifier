<h1 class="text-2xl font-bold text-center my-8">ログイン</h1>

<%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

  <div class="form-control mb-6 max-w-xs sm:max-w-sm mx-auto">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, class: "input input-bordered w-full" %>
  </div>

  <div class="form-control mb-8 max-w-xs sm:max-w-sm mx-auto">
    <%= f.label :password, "パスワード" %>
    <%= f.password_field :password, class: "input input-bordered w-full" %>
  </div>

  <div class="max-w-xs mx-auto mt-12">
    <%= f.submit "ログイン", class: "btn btn-primary w-40 mx-auto block text-lg" %>
  </div>

  <p class="text-center text-sm text-gray-500 mt-4">
    <%= link_to "パスワードを忘れた場合", new_user_password_path,
        class: "link link-primary" %>
  </p>

<% end %>

