<h1 class="text-2xl font-bold text-center my-12">パスワード再設定</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name)) do |f| %>

  <div class="form-control mb-12 max-w-sm mx-auto">
    <%= f.label :email, "メールアドレス" %>
    <%= f.email_field :email, class: "input input-bordered w-full", autofocus: true %>
  </div>

  <div class="max-w-xs mx-auto mt-16">
    <%= f.submit "送信する", class: "btn btn-primary w-40 mx-auto block text-lg" %>
  </div>
  <div class="text-center mt-6">
    <%= link_to "ログインに戻る", new_session_path(resource_name), class: "link link-primary" %>
  </div>

<% end %>
