<h1 class="text-2xl font-bold text-center my-12">新しいパスワードを設定</h1>

<%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
  
  <%= f.hidden_field :reset_password_token %>

  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="form-control mb-6 max-w-sm mx-auto">
    <%= f.label :password, "新しいパスワード" %>
    <%= f.password_field :password, class: "input input-bordered w-full", autofocus: true, autocomplete: "new-password" %>
  </div>

  <div class="form-control mb-12 max-w-sm mx-auto">
    <%= f.label :password_confirmation, "パスワード確認" %>
    <%= f.password_field :password_confirmation, class: "input input-bordered w-full", autocomplete: "new-password" %>
  </div>

  <div class="max-w-xs mx-auto mt-8">
    <%= f.submit "パスワードを変更する", class: "btn btn-primary w-52 mx-auto block text-lg" %>
  </div>

  <div class="text-center mt-6">
    <%= link_to "ログインに戻る", new_session_path(resource_name), class: "link link-primary" %>
  </div>

<% end %>
